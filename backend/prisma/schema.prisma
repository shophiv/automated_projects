datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Tenant {
  id              String       @id @default(uuid())
  business_name   String
  owner_name      String
  email           String       @unique
  phone           String
  address         String
  subscription_id String       @default("free")
  status          TenantStatus @default(PENDING)
  storage_used    Float        @default(0.0)
  global_margin   Float        @default(20.0)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  users       User[]
  audit_logs  AuditLog[]
  categories  Category[]
  products    Product[]

  @@map("tenants")
}

model User {
  id            String    @id @default(uuid())
  tenant_id     String
  name          String
  email         String    @unique
  password_hash String
  role          Role      @default(CASHIER)
  phone         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  audit_logs AuditLog[]

  @@index([tenant_id])
  @@map("users")
}

model Admin {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("admins")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenant_id  String?
  user_id    String?
  action     String
  details    String?
  timestamp  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  profit_margin Float?
  archived    Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenant_id])
  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  tenant_id      String
  category_id    String?
  supplier_id    String?
  name           String
  sku            String
  barcode        String?
  brand          String?
  purchase_price Float    @default(0.0)
  selling_price  Float    @default(0.0)
  wholesale_price Float   @default(0.0)
  discount_price Float    @default(0.0)
  tax_rate       Float    @default(0.0)
  profit_margin  Float?
  unit           String   @default("pcs")
  quantity       Float    @default(0.0)
  min_stock      Float    @default(5.0)
  max_stock      Float    @default(100.0)
  image_url      String?
  description    String?
  active_status  Boolean  @default(true)
  archived       Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([sku])
  @@index([barcode])
  @@index([category_id])
  @@map("products")
}