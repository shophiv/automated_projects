datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  ADMIN
}

model Tenant {
  id               String       @id @default(uuid())
  business_name    String
  owner_name       String
  email            String       @unique
  phone            String
  address          String
  subscription_id  String?
  status           String       @default("ACTIVE")
  storage_used     Float        @default(0.0)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  users            User[]
  categories       Category[]
  products         Product[]
}

model User {
  id            String    @id @default(uuid())
  tenant_id     String
  name          String
  email         String    @unique
  password_hash String
  role          Role      @default(CASHIER)
  is_active     Boolean   @default(true)
  last_login    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String
  max_users      Int
  max_products   Int
  features_json  String
  price          Float
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  is_archived Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenant_id, name])
}

model Product {
  id             String      @id @default(uuid())
  tenant_id      String
  category_id    String
  supplier_id    String?
  name           String
  sku            String
  barcode        String
  brand          String?
  purchase_price Float       @default(0.0)
  selling_price  Float       @default(0.0)
  wholesale_price Float      @default(0.0)
  discount_price Float       @default(0.0)
  tax_rate       Float       @default(0.0)
  unit           String      @default("pcs")
  quantity       Int         @default(0)
  min_stock      Int         @default(5)
  max_stock      Int         @default(100)
  image_url      String?
  description    String?
  is_active      Boolean     @default(true)
  is_archived    Boolean     @default(false)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category       Category    @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@unique([tenant_id, sku])
  @@unique([tenant_id, barcode])
  @@index([tenant_id])
}